# --- Server ---
PORT=3000
# Через запятую. Пусто = разрешить любой origin (только для разработки)
CORS_ORIGINS=

# --- PostgreSQL (docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=fridgy
DB_PASSWORD=change-me
DB_NAME=fridgy

# --- Auth ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Mail (необязательно) ---
# Если SMTP не задан, ссылка для сброса пароля печатается в консоль сервера
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Куда ведёт ссылка из письма (Expo web по умолчанию)
FRONTEND_URL=http://localhost:8081

# --- AI (необязательно) ---
# Пусто = MockAiService с тестовыми данными
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Storage / retention ---
STORAGE_DIR=uploads
RETENTION_DAYS=5
