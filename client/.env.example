# URL локального бэкенда (server/). Для реального телефона укажите IP компьютера.
# Android-эмулятор: http://10.0.2.2:3000, iOS-симулятор: http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Заглушка авторизации без сервера. false — использовать настоящий бэкенд
EXPO_PUBLIC_MOCK_AUTH=true
